# Create a new empty Supabase project for this portfolio.
# Do not paste keys from The Girl's Closet or Nketsiaa.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed to sign in at /admin.
ADMIN_EMAIL=

# Optional. Enquiry rows are still saved when these are empty.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Optional absolute site URL for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=
